# Copy to .env (gitignored) and fill in real values to run the Demo app. Then run
# `source scripts/load-env.sh` once per login session before building/opening Xcode — see
# scripts/load-env.sh for why a plain `export` isn't enough for a GUI-launched Xcode.

# The base64 `widget.data` blob from your merchant backend's Client Session response.
# The demo app decodes this to create a checkout.
WIDGET_DATA=

# Api key for remote log monitoring (Datadog). Leave blank to run the demo with monitoring
# disabled — the SDK sends nothing when the session carries no api key.
MONITORING_API_KEY=
